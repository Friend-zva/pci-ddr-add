#!/bin/bash

bindir="$(dirname $0)"

dev=$(lspci -d 22c2:1100)

[ -z "$dev" ] && {
  echo "Could not find the Gowin's PCIe demo device."
  # exit 1
}

echo -e "Find PCIe device:\n$dev\n"

grep -e 'Gowin' -e 'GOWIN' /usr/share/misc/pci.ids -q || {
  sudo sed -i '/Illegal Vendor ID/i\
22c2  Gowin Semiconductor Corporation' /usr/share/misc/pci.ids
}

lsmod | grep -q 'gowin_demo' || {
  sudo insmod ${bindir}/../driver/gowin_demo.ko
}

data=4096
block=128
dump=0

if [ $# -ge 1 ]; then
  data=$1
  block=$2
  dump=$3
else
  echo '*  Data   size (bytes) :'
  echo '0. default  1. 32B  2. 1KB  3. 4KB  4. 16KB  5. 1MB  6. 16MB  7. 128MB  8. 512MB'
  echo -n "Please enter your choice (1-5): "
  while true; do
    read -n 1 b
    [ "$b" -ge 0 ] && [ "$b" -le 8 ] && {
      data=$b
      break
    }
    echo -n " Invalid choice, try again: "
  done
  echo ''

  echo '*  Block  size (bytes) :'
  echo '0. default  1. 32  2. 64  3. 128  4. 256  5. 512  6. 1024  7. 2048  8. 4096'
  echo -n "Please enter your choice (1-5): "
  while true; do
    read -n 1 b
    [ "$b" -ge 0 ] && [ "$b" -le 8 ] && {
      block=$b
      break
    }
    echo -n " Invalid choice, try again: "
  done
  echo ''

  echo '*  Enable  dump (bool) :'
  echo '1. Yes  2. No'
  echo -n "Please enter your choice (1-2): "
  while true; do
    read -n 1 d
    case "$d" in
    1 | y | Y)
      dump=1
      break
      ;;
    2 | n | N)
      dump=0
      break
      ;;
    *) echo -n " Invalid choice, try again: " ;;
    esac
  done
  echo ''
fi

case $data in
1) size_data=32 ;;
2) size_data=1024 ;;
3) size_data=4096 ;;
4) size_data=16384 ;;
5) size_data=1048576 ;;
6) size_data=16777216 ;;
7) size_data=134217728 ;;
8) size_data=536870912 ;;
*) size_data=4096 ;;
esac

case $block in
1) size_block=32 ;;
2) size_block=64 ;;
3) size_block=128 ;;
4) size_block=256 ;;
5) size_block=512 ;;
6) size_block=1024 ;;
7) size_block=2048 ;;
8) size_block=4096 ;;
*) size_block=128 ;;
esac

echo "size_data=$size_data size_block=$size_block"

sudo ${bindir}/dma_demo ${size_data} ${size_block} ${dump}
